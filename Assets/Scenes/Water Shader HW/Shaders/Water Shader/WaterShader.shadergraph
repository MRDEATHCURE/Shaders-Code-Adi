{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f257905653434aa9888bd5dfad019ffc",
    "m_Title": "Final Water/ Foam Composite",
    "m_Content": "Lerp blends WaterColor (A) with Foam (B)\r\nusing FoamMask (T) as the selector.\r\n\r\nT = 0 → show Water\r\nT = 1 → show Foam\r\n\r\nFoam fully replaces water (not additive)\r\nfor clean stylized shoreline foam.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
